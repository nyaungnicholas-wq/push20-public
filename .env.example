# Copy to .env and fill in. .env is gitignored and must stay that way.
ALPACA_KEY=
ALPACA_SECRET=

# Optional. Alerts are delivered here; an unset value is skipped, not an error.
# Supported shapes: an ntfy.sh topic URL, a Discord webhook URL, or any endpoint
# that accepts a JSON {title, message, level, utc} envelope.
ROTATION_WEBHOOK_URL=
