__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# secrets — NEVER commit
.env

# logs & scratch output
*.log
out.json
err.log

# caches & transient runtime state
data/_cache/
data/paper_account.json
data/*.parquet
data/*.jsonl
data/pending_orders.json
