# tool / worktree dirs
.beprobe/
.claude/worktrees/

# Live runtime state - churns every run, and restoring an old commit would
# restore a stale drawdown baseline into the risk gate.
data/risk_state.json
data/rotation_runs.jsonl.bak-before-depollute
data/rotation_runs.test-pollution.jsonl

# research caches - large, re-downloadable
data/ff_cache/
data/pit/
data/pit_final.out
data/task-backup/
*.bak
*.bak_r1

# .env backups hold live credentials
.env.bak*
.env.*.bak
